# AI 助手配置 —— 复制本文件为 .env 并填入你的密钥，然后重启后端。
#   cp .env.example .env

# Kimi (Moonshot) 密钥，从 https://platform.moonshot.ai 获取（必填）
LLM_API_KEY=

# 以下两项有默认值，一般不用改。
# 换成 OpenAI / 本地 Ollama 等 OpenAI 兼容服务时，改这两个即可：
LLM_BASE_URL=https://api.moonshot.ai/v1
LLM_MODEL=kimi-k2.6

# 采样温度，留空即可（默认不传，用模型自带值）。
# Kimi K2.6 等推理模型只接受 1，别填其它值，否则会报 400。
LLM_TEMPERATURE=
